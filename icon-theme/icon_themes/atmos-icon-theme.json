{
  "$schema": "https://zed.dev/schema/icon_themes/v0.3.0.json",
  "name": "Atmos Icon Theme",
  "author": "James Gibbard",
  "themes": [
    {
      "name": "Atmos Icon Theme",
      "appearance": "dark",
      "directory_icons": {
        "collapsed": "__default__",
        "expanded": "__default__"
      },
      "chevron_icons": {
        "collapsed": "__default__",
        "expanded": "__default__"
      },
      "file_suffixes": {
        "yaml": "atmos",
        "yml": "atmos"
      },
      "file_icons": {
        "atmos": { "path": "./icons/file.svg" }
      }
    },
    {
      "name": "Atmos Icon Theme",
      "appearance": "light",
      "directory_icons": {
        "collapsed": "__default__",
        "expanded": "__default__"
      },
      "chevron_icons": {
        "collapsed": "__default__",
        "expanded": "__default__"
      },
      "file_suffixes": {
        "yaml": "atmos",
        "yml": "atmos"
      },
      "file_icons": {
        "atmos": { "path": "./icons/file.svg" }
      }
    }
  ]
}
